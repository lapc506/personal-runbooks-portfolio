#!/usr/bin/env bash
# Claude Code con Gemini (Gemini API o Vertex AI) via liteLLM proxy
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
LOCAL_DIR="$HOME/.config/litellm-claude"
CONFIG="${SCRIPT_DIR}/config.yaml"
ENV_FILE="${LOCAL_DIR}/.env"
LITELLM_LOG="${LOCAL_DIR}/proxy.log"
PIDFILE="${LOCAL_DIR}/proxy.pid"
DEBUG_LOG="${LOCAL_DIR}/debug.log"

# PATH propagation: when launched via the GNOME .desktop shortcut, the PATH
# exported by claude-code-vertex-gui does NOT survive `exec alacritty -e` — the
# inner process inherits the bare session PATH, so gcloud / bun / nvm-node go
# missing for `claude` and every child it spawns (MCP stdio servers, npx, and
# Bash tool calls). Rebuild PATH HERE, in the script that actually execs
# `claude`, so the fix holds no matter how we were launched (GUI or direct).
: "${NVM_DIR:=$HOME/.nvm}"
NVM_NODE_BIN=""
if [ -d "$NVM_DIR/versions/node" ]; then
  nvm_default="$(cat "$NVM_DIR/alias/default" 2>/dev/null || true)"
  [ -z "$nvm_default" ] && nvm_default="node"
  candidate="$NVM_DIR/versions/node/$nvm_default/bin"
  if [ -d "$candidate" ]; then
    NVM_NODE_BIN="$candidate"
  else
    # Fallback: latest installed node version (version sort, good enough)
    latest="$(ls -1 "$NVM_DIR/versions/node" 2>/dev/null | sort -V | tail -n1 || true)"
    [ -n "$latest" ] && [ -d "$NVM_DIR/versions/node/$latest/bin" ] \
      && NVM_NODE_BIN="$NVM_DIR/versions/node/$latest/bin"
  fi
fi
# Prepend the dirs that GUI launches drop, then keep whatever PATH we inherited
# (system dirs + any plugin bins). Duplicate entries are harmless.
export PATH="$HOME/.local/bin:$HOME/.bun/bin${NVM_NODE_BIN:+:$NVM_NODE_BIN}:$HOME/google-cloud-sdk/bin:${PATH}"

# Source .env si existe
[ -f "$ENV_FILE" ] && set -a && . "$ENV_FILE" && set +a

# Debug dump (solo al archivo, no a pantalla)
{
  echo ""
  echo "============================================"
  echo "[DEBUG] $(date)"
  echo "============================================"
  echo "SCRIPT_DIR:        $SCRIPT_DIR"
  echo "CONFIG:            $CONFIG"
  echo "ENV_FILE:          $ENV_FILE"
  echo "LOCAL_DIR:         $LOCAL_DIR"
  echo "CONFIG exists:     $( [ -f "$CONFIG" ] && echo YES || echo NO )"
  echo "ENV_FILE exists:   $( [ -f "$ENV_FILE" ] && echo YES || echo NO )"
  echo "ADC file exists:   $( [ -f "$HOME/.config/gcloud/application_default_credentials.json" ] && echo YES || echo NO )"
  # Masked: report only presence + length, NEVER the secret value (the previous
  # ${VAR:-unset} fallback printed the real key to debug.log when VAR was set).
  echo "GEMINI_API_KEY:     $( [ -n "${GEMINI_API_KEY:-}" ] && echo "set (${#GEMINI_API_KEY} chars)" || echo unset )"
  echo "OPENCODE_GO_API_KEY: $( [ -n "${OPENCODE_GO_API_KEY:-}" ] && echo "set (${#OPENCODE_GO_API_KEY} chars)" || echo unset )"
  echo "GOOGLE_CREDENTIALS:  ${GOOGLE_APPLICATION_CREDENTIALS:-unset}"
  echo "LITELLM_MASTER_KEY: $( [ -n "${LITELLM_MASTER_KEY:-}" ] && echo "set (${#LITELLM_MASTER_KEY} chars)" || echo unset )"
  echo "WHOAMI:            $(whoami)"
  echo "HOME:              $HOME"
  echo "CLAUDE:            $(which claude 2>/dev/null || echo 'NOT FOUND')"
  echo "LITELLM:           $(which litellm 2>/dev/null || echo 'NOT FOUND')"
  echo "============================================"
} >> "$DEBUG_LOG"

export LITELLM_MASTER_KEY="${LITELLM_MASTER_KEY:-sk-local-dojo-agent}"
LITELLM_KEY="$LITELLM_MASTER_KEY"
USE_PROXY=true

# CLAUDE_CONFIG_DIR home (cuenta/settings). pick_config_dir lo elige en el
# pipeline; este default defensivo cubre cualquier uso previo de $CC_DIR y
# respeta un CLAUDE_CONFIG_DIR ya exportado (p. ej. lanzado vía alias).
CC_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

# --- Helper: guardar variable en .env ---
save_to_env() {
  local key="$1" val="$2"
  if grep -q "^${key}=" "$ENV_FILE" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${val}|" "$ENV_FILE"
  else
    echo "${key}=${val}" >> "$ENV_FILE"
  fi
  chmod 600 "$ENV_FILE"
  export "${key}=${val}"
}

# --- Detección de backends ---
has_gemini_api() { [ -n "${GEMINI_API_KEY:-}" ]; }
has_vertex_ai() {
  [ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ] && return 0
  [ -f "$HOME/.config/gcloud/application_default_credentials.json" ] && return 0
  return 1
}

GO_MODELS=(
  "minimax-m2.7|MiniMax M2.7"
  "minimax-m2.5|MiniMax M2.5"
)

BACKENDS=(
  "1|Anthropic directo (login propio)|anthropic-direct|none"
  "2|Gemini API (API key)|gemini-pro|GEMINI_API_KEY"
  "3|Vertex AI (GCP credentials)|vertex-gemini-pro|gcloud"
  "4|OpenCode Go|opencode-go|OPENCODE_GO_API_KEY"
)

pick_model() {
  echo ""
  echo "Backends disponibles:"
  for be in "${BACKENDS[@]}"; do
    local num="${be%%|*}"; local rest="${be#*|}"
    local label="${rest%%|*}"; rest="${rest#*|}"
    echo "  $num) $label"
  done
  echo ""

  while true; do
    printf "Elegí backend [1-${#BACKENDS[@]}]: "
    read -r choice
    for be in "${BACKENDS[@]}"; do
      local num="${be%%|*}"; local rest="${be#*|}"
      local label="${rest%%|*}"; rest="${rest#*|}"
      local model="${rest%%|*}"; local req="${rest#*|}"
      [ "$choice" != "$num" ] && continue

      echo "Usando $label"

      if [ "$req" = "none" ]; then
        MODEL="$model"; USE_PROXY=false; return
      fi

      if [ "$req" = "gcloud" ]; then
        if ! has_vertex_ai; then
          echo "Vertex AI necesita credenciales de gcloud."
          echo "Ejecutá en otra terminal:"
          echo "  gcloud auth application-default login"
          echo "O configurá GOOGLE_APPLICATION_CREDENTIALS en $ENV_FILE"
          echo ""
          read -rp "Presiona Enter cuando tengas las credenciales listas..."
          if has_vertex_ai; then
            MODEL="$model"; USE_PROXY=true; return
          fi
          echo "Todavía no hay credenciales. Cancelando."
          break
        fi
        MODEL="$model"; USE_PROXY=true; return
      fi

      # Requiere API key — pedir si falta
      if [ -z "${!req:-}" ]; then
        echo "$req no está configurada."
        read -rp "Ingresá tu API key para $label: " apikey
        if [ -n "$apikey" ]; then
          save_to_env "$req" "$apikey"
          echo "$req guardada en $ENV_FILE"
        else
          echo "API key vacía. Cancelando."
          break
        fi
      fi

      if [ "$model" = "opencode-go" ]; then
        USE_PROXY=false; pick_go_model; return
      else
        USE_PROXY=true; MODEL="$model"; return
      fi
    done
  done
}

pick_go_model() {
  echo ""
  echo "Modelos Go disponibles (Anthropic-compatibles):"
  for j in "${!GO_MODELS[@]}"; do
    local id="${GO_MODELS[$j]%%|*}"
    local name="${GO_MODELS[$j]##*|}"
    echo "  $((j+1))) $name ($id)"
  done
  echo ""
  while true; do
    read -rp "Elegí modelo [1-${#GO_MODELS[@]}]: " gsel
    if [ "$gsel" -ge 1 ] && [ "$gsel" -le "${#GO_MODELS[@]}" ] 2>/dev/null; then
      local idx=$((gsel - 1))
      MODEL="${GO_MODELS[$idx]%%|*}"
      echo "Usando $MODEL"
      return
    fi
    echo "Opción inválida"
  done
}

# --- Selección de sesión ---

# Ventana y tope para listar transcripts huérfanos (sesiones reales sin
# heartbeat vivo ni respaldo). Mantiene el menú acotado sin perder recuperación.
ORPHAN_MAX_AGE_DAYS="${ORPHAN_MAX_AGE_DAYS:-14}"
ORPHAN_LIMIT="${ORPHAN_LIMIT:-25}"

# _session_meta FILE  → imprime  label|uuid|cwd_display|cwd_raw
# Acepta tanto un heartbeat .json (sessions/ o sessions-backup/) como un
# transcript real .jsonl (~/.claude/projects/<proj>/<uuid>.jsonl). El FILE se
# pasa como argv (no se interpola en el source) para no romper con rutas raras.
_session_meta() {
  python3 - "$1" <<'PY'
import json, os, sys

path = sys.argv[1]
home = os.environ.get('HOME', '')

def disp(c):
    return ('~' + c[len(home):]) if c and c.startswith(home) else c

name = uuid = cwd = ''

if path.endswith('.jsonl'):
    # Transcript real: barrer líneas hasta tener lo necesario, luego cortar.
    first = ''
    try:
        with open(path, encoding='utf-8', errors='replace') as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                if not uuid and o.get('sessionId'):
                    uuid = o['sessionId']
                if not cwd and o.get('cwd'):
                    cwd = o['cwd']
                if not name and o.get('type') == 'summary':
                    name = (o.get('summary') or '').strip()
                if not first and o.get('type') == 'user':
                    c = (o.get('message') or {}).get('content')
                    if isinstance(c, str):
                        t = c
                    elif isinstance(c, list):
                        t = next((b.get('text', '') for b in c
                                  if isinstance(b, dict) and b.get('type') == 'text'), '')
                    else:
                        t = ''
                    t = t.strip()
                    if t and not t.startswith('<') and 'tool_result' not in t:
                        first = t
                if uuid and cwd and (name or first):
                    break
    except Exception:
        pass
    if not uuid:
        uuid = os.path.splitext(os.path.basename(path))[0]
    label = name or first or '(sin nombre)'
else:
    # Heartbeat de proceso (vivo o respaldo).
    try:
        d = json.load(open(path))
    except Exception:
        d = {}
    uuid = d.get('sessionId', '')
    cwd = d.get('cwd', '')
    label = d.get('name') or '(sin nombre)'

label = ' '.join(label.split())[:60]
print(f"{label}|{uuid}|{disp(cwd)}|{cwd}")
PY
}

# Lee el sessionId de un archivo de sesión. Acepta tanto un heartbeat .json
# (un solo objeto: sessions/ y sessions-backup/) como un transcript .jsonl
# (JSON Lines: ~/.claude/projects/<proj>/<uuid>.jsonl, que el bucle de orden
# le pasa para las huérfanas). json.load() solo parsea UN objeto, así que sobre
# un .jsonl multilínea lanzaba JSONDecodeError → python3 exit 1 → bajo set -e la
# asignación `_u=$(_heartbeat_uuid ...)` mataba el script (y con él la terminal
# lanzada por `alacritty -e`). Intenta json.load (rápido para .json) y, si falla,
# barre líneas como JSONL. NUNCA retorna ≠0: el `|| true` final lo garantiza.
_heartbeat_uuid() {
  python3 - "$1" 2>/dev/null <<'PY' || true
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    d = {}
    for line in open(sys.argv[1], encoding='utf-8', errors='replace'):
        line = line.strip()
        if not line:
            continue
        try:
            o = json.loads(line)
        except Exception:
            continue
        if isinstance(o, dict) and o.get('sessionId'):
            d = o
            break
print(d.get('sessionId', '') if isinstance(d, dict) else '')
PY
}

# ¿El heartbeat corresponde a un proceso claude realmente vivo?
# Claude Code borra su heartbeat al salir limpio, pero un crash duro (freeze
# de GPU/compositor, corte de energía) lo deja huérfano; sin esta validación
# la sesión muerta se lista como "activa (sin nombre)" y la dedup por UUID
# le tapa las ramas [respaldo]/[huérfana]. Valida `kill -0 PID` y, si el
# heartbeat trae procStart (starttime de /proc/<pid>/stat), también lo
# compara para descartar reuso de PID tras un reinicio.
_heartbeat_alive() {
  local f="$1" pid start
  IFS='|' read -r pid start < <(python3 -c "
import json, sys
d = json.load(open(sys.argv[1]))
print(f\"{d.get('pid', '')}|{d.get('procStart', '')}\")" "$f" 2>/dev/null)
  [ -n "$pid" ] || return 0   # sin campo pid: asumir vivo (comportamiento previo)
  kill -0 "$pid" 2>/dev/null || return 1
  if [ -n "$start" ] && [ -r "/proc/$pid/stat" ]; then
    # starttime es el campo 22 de /proc/<pid>/stat; el comm entre paréntesis
    # puede contener espacios, así que se recorta hasta ") " y queda en $20.
    local actual
    actual=$(awk '{sub(/.*\) /,""); print $20}' "/proc/$pid/stat" 2>/dev/null)
    if [ -n "$actual" ] && [ "$actual" != "$start" ]; then
      return 1   # PID reusado por otro proceso
    fi
  fi
  return 0
}

# Respalda metadata de una sesión a sessions-backup/<uuid>.json para que
# reaparezca aunque el proceso muera sin limpieza (freeze/reinicio).
_backup_session() {
  local kind="$1" f="$2" uuid="$3" cwd="$4" name="$5"
  local backup_dir="$CC_DIR/sessions-backup"
  [ -n "$uuid" ] || return 0
  if [ "$kind" = "active" ] || [ "$kind" = "backup" ]; then
    cp "$f" "$backup_dir/$uuid.json" 2>/dev/null && return 0
  fi
  # Huérfana (o fallback): sintetizar metadata mínima desde el transcript.
  python3 - "$backup_dir/$uuid.json" "$uuid" "$cwd" "$name" <<'PY' 2>/dev/null || true
import json, sys, time
dest, uuid, cwd, name = sys.argv[1:5]
rec = {"sessionId": uuid, "cwd": cwd, "kind": "interactive",
       "status": "orphan-backup", "updatedAt": int(time.time() * 1000)}
if name and name != '(sin nombre)':
    rec["name"] = name
json.dump(rec, open(dest, "w"))
PY
}

# cwd de CREACIÓN de una sesión: el primer `cwd` registrado en su transcript
# real (~/.claude/projects/<proj>/<uuid>.jsonl). Ese es el único cwd que mapea
# al project-dir donde Claude Code archivó el transcript, y por lo tanto el
# único desde el que `claude --resume UUID` la encuentra. El heartbeat/respaldo
# guarda el ÚLTIMO cwd: si la sesión cambió de worktree a mitad de vida (típico
# con worktrees), ese cwd ya no mapea al transcript y el --resume falla con
# "No conversation found". Vacío si no hay transcript o el id no es un UUID.
_creation_cwd_for_uuid() {
  local uuid="$1" tr
  [[ "$uuid" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || return 0
  # -L: $CC_DIR/projects suele ser un symlink a ~/.claude/projects (homes de
  # cuenta comparten transcripts vía symlink). find -P (default) NO sigue un
  # symlink dado como punto de partida → no desciende → encuentra cero. Sin -L,
  # toda la recuperación de huérfanas queda muerta justo en el caso que importa.
  tr=$(find -L "$CC_DIR/projects" -maxdepth 2 -type f -name "$uuid.jsonl" -print -quit 2>/dev/null)
  [ -n "$tr" ] || return 0
  python3 -c "
import json, sys
for line in open(sys.argv[1], encoding='utf-8', errors='replace'):
    line = line.strip()
    if not line:
        continue
    try:
        o = json.loads(line)
    except Exception:
        continue
    if o.get('cwd'):
        print(o['cwd'])
        break
" "$tr" 2>/dev/null
}

# Epoch (segundos) de CREACIÓN de una sesión, para ordenar el menú por fecha
# de nacimiento real y no por mtime (= última escritura del transcript, que es
# lo que reportan `ls -t`/`stat %y`/`find -printf %T@`). La verdad de la
# creación vive DENTRO del .jsonl: el primer registro con `timestamp`. Acepta
# tanto un heartbeat .json (resuelve el .jsonl por UUID) como el propio
# transcript. Si no hay transcript ni timestamp, cae al mtime del archivo.
_creation_epoch() {
  local f="$1" uuid="$2" tr="" ts=""
  if [[ "$uuid" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
    tr=$(find -L "$CC_DIR/projects" -maxdepth 2 -type f -name "$uuid.jsonl" -print -quit 2>/dev/null)
  fi
  [ -z "$tr" ] && [[ "$f" == *.jsonl ]] && tr="$f"
  if [ -n "$tr" ]; then
    ts=$(python3 - "$tr" <<'PY' 2>/dev/null
import sys, json
from datetime import datetime
for line in open(sys.argv[1], encoding='utf-8', errors='replace'):
    line = line.strip()
    if not line:
        continue
    try:
        o = json.loads(line)
    except Exception:
        continue
    t = o.get('timestamp')
    if not t:
        continue
    try:
        print(int(datetime.fromisoformat(t.replace('Z', '+00:00')).timestamp()))
        break
    except Exception:
        continue
PY
)
  fi
  if [ -n "$ts" ]; then
    echo "$ts"
  else
    stat -c '%Y' "$f" 2>/dev/null || echo 0
  fi
}

# Garantiza un cwd válido antes de `claude --resume UUID`.
# Claude Code resuelve --resume por el mapeo cwd→~/.claude/projects/<dir-codificado>;
# retomar desde otro directorio termina en "session not found". Si el cwd
# original fue borrado (caso típico: limpieza de worktree post-merge), lo
# recrea: el transcript .jsonl es la verdad de la sesión, el directorio es
# solo el punto de anclaje del mapeo. Nunca falla: como último recurso avisa
# y retoma desde el cwd actual.
_ensure_session_cwd() {
  local uuid="$1" orig_cwd="$2"

  if [ -z "$orig_cwd" ]; then
    echo "AVISO: la sesión no registra cwd original; retomando desde $(pwd)."
    echo "       Si claude no encuentra la sesión $uuid, retomala desde su directorio original."
    return 0
  fi

  if [ ! -d "$orig_cwd" ]; then
    echo "AVISO: el cwd original de la sesión ya no existe (¿worktree limpiado post-merge?):"
    echo "       $orig_cwd"
    read -rp "¿Recrearlo (vacío) para poder retomar la sesión? [S/n]: " recreate
    if [ "$recreate" = "n" ] || [ "$recreate" = "N" ]; then
      echo "AVISO: sin ese cwd, claude probablemente no encuentre la sesión $uuid."
      echo "       Retomando desde $(pwd) de todos modos."
      return 0
    fi
    if ! mkdir -p "$orig_cwd" 2>/dev/null; then
      echo "ERROR: no pude recrear $orig_cwd (¿permisos? ¿punto de montaje ausente?)."
      echo "       Retomando desde $(pwd); es probable que claude no encuentre la sesión."
      return 0
    fi
    echo "Directorio recreado: $orig_cwd"
    echo "(quedó vacío — sin git ni .env; si la sesión va a tocar código, movela al checkout real)"
  fi

  cd "$orig_cwd"
  echo "Cambiando a $orig_cwd"
}

# Resume por ID manual: resuelve short-ID, localiza el cwd de la sesión
# (heartbeat vivo → respaldo → transcript en ~/.claude/projects) y lo
# garantiza con _ensure_session_cwd antes de armar RESUME_FLAG. Sin esto,
# un --resume manual desde el directorio equivocado falla siempre.
_manual_resume() {
  local manual_id="$1"
  local resolved hb cwd=""
  resolved=$(resolve_session_id "$manual_id")

  # 1) Heartbeat (sessions/ o sessions-backup/) con el id resuelto como nombre.
  for hb in "$CC_DIR/sessions/$resolved.json" \
            "$CC_DIR/sessions-backup/$resolved.json"; do
    if [ -f "$hb" ]; then
      cwd=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('cwd',''))" "$hb" 2>/dev/null)
      break
    fi
  done

  # 2) Transcript real por UUID (cubre huérfanas fuera de la ventana del menú).
  if [ -z "$cwd" ] && [[ "$manual_id" =~ ^[0-9a-f-]{36}$ ]]; then
    local tr
    tr=$(find -L "$CC_DIR/projects" -maxdepth 2 -type f \
           -name "$manual_id.jsonl" -print -quit 2>/dev/null)
    if [ -n "$tr" ]; then
      local _n _u _cd
      IFS='|' read -r _n _u _cd cwd < <(_session_meta "$tr")
    fi
  fi

  # 3) Preferir el cwd de CREACIÓN (transcript) sobre el del heartbeat: si la
  #    sesión migró de worktree, solo el de creación mapea al project-dir y
  #    permite que --resume la encuentre. (manual_id puede ser el UUID; el
  #    transcript se nombra por UUID, así que resolvemos contra él.)
  local _ccwd
  _ccwd=$(_creation_cwd_for_uuid "$manual_id")
  if [ -n "$_ccwd" ] && [ "$_ccwd" != "$cwd" ]; then
    [ -n "$cwd" ] && echo "Nota: heartbeat apunta a '$cwd'; uso el cwd de creación del transcript."
    cwd="$_ccwd"
  fi

  _ensure_session_cwd "$resolved" "$cwd"
  RESUME_FLAG="--resume $resolved"
  echo "Retomando sesión $resolved"
}

# --- Helpers de formato del menú (layout responsive) ---
# Ancho de la terminal en columnas. tput primero (lee el TTY real, así respeta
# el layout vertical/horizontal del momento), luego $COLUMNS, y 80 de piso.
_term_cols() {
  local c
  c=$(tput cols 2>/dev/null) || c=""
  [[ "$c" =~ ^[0-9]+$ ]] || c="${COLUMNS:-80}"
  [[ "$c" =~ ^[0-9]+$ ]] || c=80
  echo "$c"
}

# Abrevia un path a <=max chars conservando el ÚLTIMO componente, que es lo que
# distingue una sesión: ~/Documentos/GitHub/foo/bar/monorepo → ~/…/monorepo.
# Si ni así entra, deja solo el final con elipsis a la izquierda.
_abbrev_path() {
  local p="$1" max="$2"
  [ "${#p}" -le "$max" ] && { printf '%s' "$p"; return; }
  local base="${p##*/}" head="${p%%/*}"
  local cand="$head/…/$base"
  if [ "${#cand}" -le "$max" ]; then
    printf '%s' "$cand"
  else
    printf '…%s' "${base: -$((max - 1))}"
  fi
}

# Trunca a <=max chars con … si recorta. Opera por CARÁCTER (no byte): en locale
# UTF-8, ${#s} y ${s:0:n} cuentan caracteres, así que acentos y emojis de las
# descripciones no se parten a la mitad.
_ellipsize() {
  local s="$1" max="$2"
  [ "${#s}" -le "$max" ] && { printf '%s' "$s"; return; }
  printf '%s…' "${s:0:$((max - 1))}"
}

pick_session() {
  local session_dir="$CC_DIR/sessions"
  local backup_dir="$CC_DIR/sessions-backup"
  local projects_dir="$CC_DIR/projects"
  mkdir -p "$backup_dir" "$session_dir"

  local entries=()
  local seen_uuids=" "   # set (con padding de espacios) de UUIDs ya listados
  local i=0

  # 1) Sesiones activas: heartbeats de procesos claude vivos (PID validado;
  #    un heartbeat de un proceso muerto se degrada a la rama [respaldo]).
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    local u; u=$(_heartbeat_uuid "$f")
    if ! _heartbeat_alive "$f"; then
      # Crash duro: sintetizar el respaldo que el proceso nunca llegó a
      # escribir (-u: solo si el heartbeat es más nuevo que el respaldo).
      # No se marca en seen_uuids → la rama 2 lo lista como [respaldo].
      if [ -n "$u" ]; then
        cp -u "$f" "$backup_dir/$u.json" 2>/dev/null || true
      fi
      continue
    fi
    entries+=("active:$f")
    [ -n "$u" ] && seen_uuids+="$u "
  done < <(ls -t "$session_dir"/*.json 2>/dev/null)

  # 2) Respaldos: solo si su UUID no está ya activo.
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    local u; u=$(_heartbeat_uuid "$f")
    case "$seen_uuids" in *" $u "*) continue ;; esac
    entries+=("backup:$f")
    [ -n "$u" ] && seen_uuids+="$u "
  done < <(ls -t "$backup_dir"/*.json 2>/dev/null)

  # 3) Transcripts huérfanos: sesiones reales en ~/.claude/projects sin
  #    heartbeat vivo ni respaldo. Cierra el hueco donde un freeze/reinicio
  #    mata la sesión antes de respaldarla (ver README "Recuperación").
  #    -maxdepth 2 lista projects/<proj>/<uuid>.jsonl y excluye los
  #    agent-*.jsonl de subagentes (que viven más profundo).
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    local u; u=$(basename "$f" .jsonl)
    [[ "$u" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || continue
    case "$seen_uuids" in *" $u "*) continue ;; esac
    entries+=("orphan:$f")
    seen_uuids+="$u "
  done < <(find -L "$projects_dir" -maxdepth 2 -type f -name '*.jsonl' \
              -mtime -"$ORPHAN_MAX_AGE_DAYS" -printf '%T@\t%p\n' 2>/dev/null \
            | sort -rn | cut -f2- | head -n "$ORPHAN_LIMIT")

  if [ ${#entries[@]} -eq 0 ]; then
    echo "No hay sesiones guardadas."
    read -rp "¿Ingresar ID manualmente? [s/N]: " manual
    if [ "$manual" = "s" ] || [ "$manual" = "S" ]; then
      read -rp "Session ID: " manual_id
      if [ -n "$manual_id" ]; then
        _manual_resume "$manual_id"
        return
      fi
    fi
    RESUME_FLAG=""
    echo "Nueva sesión"
    return
  fi

  # Orden GLOBAL por fecha de creación (desc). Antes el listado eran tres
  # bloques concatenados (activa → respaldo → cerrada), cada uno ordenado por
  # su cuenta, así que una sesión recién cerrada nunca podía ser la #1: caía
  # debajo de toda activa/respaldo sin importar cuándo había nacido. Acá se
  # unifican los tres tipos en una sola lista ordenada por epoch de creación,
  # y `entry_epochs` queda en paralelo para mostrar esa misma fecha en el menú.
  local entry_epochs=()
  if [ ${#entries[@]} -gt 0 ]; then
    local sortable=()
    for entry in "${entries[@]}"; do
      local _f="${entry#*:}"
      # `|| true`: defensa en profundidad contra la trampa de set -e — una
      # asignación pelada cuyo $( ) falla aborta el script. _heartbeat_uuid ya
      # no debería fallar, pero el bucle mezcla .json y .jsonl a propósito.
      local _u; _u=$(_heartbeat_uuid "$_f") || true
      [ -n "$_u" ] || _u=$(basename "$_f" .jsonl)
      local _ep; _ep=$(_creation_epoch "$_f" "$_u")
      sortable+=("$_ep|$entry")
    done
    entries=()
    while IFS= read -r _line; do
      entry_epochs+=("${_line%%|*}")
      entries+=("${_line#*|}")
    done < <(printf '%s\n' "${sortable[@]}" | sort -t'|' -k1,1nr)
  fi

  echo ""
  echo "Sesiones existentes:"
  echo "  0) Nueva sesión"
  # UNA sola columna de UUID: el "short id" de huérfanas/respaldos ERA el UUID
  # (el transcript se llama <uuid>.jsonl), por eso aparecía duplicado. Y las
  # filas se arman con TAB y se alinean con `column -t` en vez de espacios
  # fijos — el ancho variable de los campos descuadraba todo.
  # Formato responsive: en terminal angosta (layout vertical) compactamos cada
  # sesión a UNA línea — fecha corta, UUID a 8 chars, cwd abreviado y descripción
  # truncada — para que no se envuelva. En terminal ancha va todo completo.
  local cols; cols=$(_term_cols)
  # Umbral alto a propósito: el formato ANCHO (UUID de 36 + cwd y descripción
  # completos) recién deja de envolver pasados ~150 cols. Una pantalla en layout
  # VERTICAL ronda 110-120 cols (fuente chica) → entra en compacto; horizontal
  # (~190+) → ancho. Ajustá este número si tu vertical/horizontal difieren.
  local narrow=0; [ "$cols" -lt 150 ] && narrow=1
  # Reparto del ancho sobrante: priorizamos el PATH (identifica el repo) sobre la
  # descripción. cwd hasta ~1/3 del ancho (tope 50: alcanza para los paths
  # normales completos; solo worktrees larguísimos se abrevian) y la descripción
  # se queda con el resto, más resumida.
  local cwd_max=$(( cols / 3 ))
  [ "$cwd_max" -gt 50 ] && cwd_max=50; [ "$cwd_max" -lt 16 ] && cwd_max=16
  local name_max=$(( cols - 46 - cwd_max )); [ "$name_max" -lt 14 ] && name_max=14

  local rows=()
  local n=${#entries[@]}
  local idx
  for ((idx = 0; idx < n; idx++)); do
    local entry="${entries[$idx]}"
    i=$((idx + 1))
    local kind="${entry%%:*}"
    local f="${entry#*:}"
    local name uuid cwd _raw
    IFS='|' read -r name uuid cwd _raw < <(_session_meta "$f")
    # Fecha de CREACIÓN (epoch ya calculado para el sort), no el mtime: si
    # mostrara mtime, las filas se verían desordenadas respecto a la columna.
    local ep="${entry_epochs[$idx]}" created="?"
    local _datefmt='+%Y-%m-%d %H:%M'; [ "$narrow" = "1" ] && _datefmt='+%m-%d %H:%M'
    [ -n "$ep" ] && [ "$ep" != "0" ] && created=$(date -d "@$ep" "$_datefmt" 2>/dev/null)
    # kind "orphan" = transcript sin heartbeat vivo ni respaldo. En la práctica
    # eso es una sesión CERRADA limpiamente (Claude Code borra su heartbeat al
    # salir): el crash duro deja heartbeat zombi y lo agarra la pasada 1 como
    # [respaldo]. Por eso la etiqueta visible es [cerrada], no [huérfana].
    local tag="[activa]"
    case "$kind" in
      backup) tag="[respaldo]" ;;
      orphan) tag="[cerrada]" ;;
    esac
    # En modo compacto recortamos UUID (8 chars), cwd y descripción para que la
    # fila entre en una sola línea; en modo ancho va todo sin tocar.
    local show_uuid="$uuid" show_cwd="$cwd" show_name="$name"
    if [ "$narrow" = "1" ]; then
      show_uuid="${uuid:0:8}"
      show_cwd="$(_abbrev_path "$cwd" "$cwd_max")"
      show_name="$(_ellipsize "$name" "$name_max")"
    fi
    rows+=("$(printf '%d)\t%s\t%s\t%s\t%s\t%s' "$i" "$created" "$show_uuid" "$tag" "$show_cwd" "$show_name")")
  done
  if command -v column >/dev/null 2>&1; then
    local _aligned
    _aligned=$(printf '%s\n' "${rows[@]}" | column -t -s "$(printf '\t')")
    # Backstop (AMBOS modos): si tras alinear alguna fila excede el ancho útil
    # (cols menos los 2 de indent), recortala con elipsis para garantizar que
    # NUNCA se envuelva — ni siquiera si el formato ancho no entra del todo.
    _aligned=$(printf '%s\n' "$_aligned" \
      | awk -v w=$((cols - 2)) '{ if (length($0) > w) $0 = substr($0, 1, w - 1) "…"; print }')
    printf '%s\n' "$_aligned" | sed 's/^/  /'
  else
    printf '  %s\n' "${rows[@]//$'\t'/  }"
  fi
  echo "  m) Ingresar ID manualmente"
  echo ""

  while true; do
    read -rp "Elegí sesión para retomar [0-${#entries[@]}]: " sel
    if [ "$sel" = "0" ] || [ -z "$sel" ]; then
      RESUME_FLAG=""
      echo "Nueva sesión"
      break
    fi
    if [ "$sel" = "m" ] || [ "$sel" = "M" ]; then
      read -rp "Session ID: " manual_id
      if [ -n "$manual_id" ]; then
        _manual_resume "$manual_id"
      else
        RESUME_FLAG=""
        echo "Nueva sesión"
      fi
      break
    fi
    if [ "$sel" -ge 1 ] && [ "$sel" -le "${#entries[@]}" ] 2>/dev/null; then
      local idx=$((sel - 1))
      local entry="${entries[$idx]}"
      local kind="${entry%%:*}"
      local f="${entry#*:}"

      local name uuid cwd_disp orig_cwd
      IFS='|' read -r name uuid cwd_disp orig_cwd < <(_session_meta "$f")

      # Para active/backup el cwd salió del heartbeat (ÚLTIMO cwd); si la sesión
      # migró de worktree, ese cwd no mapea al transcript y --resume falla. El
      # cwd de creación (primer cwd del .jsonl) es la fuente autoritativa para
      # --resume. (Para orphan, _session_meta ya leyó el .jsonl → coincide, no-op.)
      local creation_cwd
      creation_cwd=$(_creation_cwd_for_uuid "$uuid")
      if [ -n "$creation_cwd" ] && [ "$creation_cwd" != "$orig_cwd" ]; then
        echo "Nota: la sesión cambió de directorio durante su vida."
        echo "      heartbeat: $orig_cwd"
        echo "      creación:  $creation_cwd  ← usando este para --resume"
        orig_cwd="$creation_cwd"
      fi

      # Respaldar antes de reanudar (por si crashea sin limpieza). Para
      # huérfanas además sintetiza el respaldo que nunca llegó a existir.
      if [ "$kind" = "active" ] || [ "$kind" = "orphan" ]; then
        _backup_session "$kind" "$f" "$uuid" "$orig_cwd" "$name"
        echo "Sesión respaldada en $backup_dir/$uuid.json"
      fi

      # cd al cwd original de la sesión (recreándolo si fue borrado;
      # un cd salteado en silencio rompe el --resume desde otro proyecto)
      _ensure_session_cwd "$uuid" "$orig_cwd"

      RESUME_FLAG="--resume $uuid"
      echo "Retomando sesión $uuid"
      break
    fi
    echo "Opción inválida"
  done
}

# Resuelve UUID a short ID buscando en sesiones y backups
resolve_session_id() {
  local input="$1"
  # Si no parece UUID (sin guiones), es short ID directo
  if ! [[ "$input" =~ ^[0-9a-f-]{36}$ ]]; then
    echo "$input"
    return
  fi
  # Buscar UUID en active + backup jsons
  for dir in "$CC_DIR/sessions" "$CC_DIR/sessions-backup"; do
    for f in "$dir"/*.json; do
      [ -f "$f" ] || continue
      if python3 -c "import json; exit(0 if json.load(open('$f')).get('sessionId') == '$input' else 1)" 2>/dev/null; then
        local found=$(basename "$f" .json)
        echo "UUID resuelto a short ID: $found" >&2
        echo "$found"
        return
      fi
    done
  done
  echo "$input"
}

# --- Cleanup del proxy ---
cleanup() {
  if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null || true
    rm -f "$PIDFILE"
  fi
}
trap cleanup EXIT INT TERM

# Mata cualquier proceso usando el puerto 4000
kill_port_4000() {
  local pids
  pids=$(lsof -ti :4000 2>/dev/null || true)
  if [ -n "$pids" ]; then
    echo "Puerto 4000 ocupado por PID(s) $pids — matando..."
    kill $pids 2>/dev/null || true
    sleep 1
  fi
}

# --- Selección de settings / cuenta (CLAUDE_CONFIG_DIR) ---
# andres por default; claude-fa (hello@) para Freedom Academy. Cada home aísla
# sus credenciales y comparte memory/plugins/skills/hooks vía symlinks (ver
# ~/.claude-account-setup.sh). Esto debe correr ANTES de pick_session: los
# heartbeats de sesión viven bajo $CC_DIR, así que el selector lista la cuenta
# correcta (los transcripts en projects/ están compartidos por symlink).
pick_config_dir() {
  echo ""
  echo "¿Con cuáles settings de Claude Code querés cargar?"
  echo "  1) claude-andres  (default)         -> ~/.claude-andres"
  echo "  2) claude-fa      (Freedom Academy) -> ~/.claude-hello"
  echo ""
  local sel
  read -rp "Elegí [1-2, Enter=1]: " sel
  case "$sel" in
    2) export CLAUDE_CONFIG_DIR="$HOME/.claude-hello"; echo "Settings: claude-fa (hello@)" ;;
    *) export CLAUDE_CONFIG_DIR="$HOME/.claude-andres"; echo "Settings: claude-andres" ;;
  esac
  CC_DIR="$CLAUDE_CONFIG_DIR"
  mkdir -p "$CC_DIR"
  if [ ! -e "$CC_DIR/.credentials.json" ]; then
    echo "AVISO: $CC_DIR aún no tiene credenciales — Claude pedirá /login."
  fi
}

# --- Pipeline ---
pick_config_dir
pick_model

echo ""
read -rp "¿Retomar sesión existente? [s/N]: " resume_choice
if [ "$resume_choice" = "s" ] || [ "$resume_choice" = "S" ]; then
  pick_session
else
  RESUME_FLAG=""
  echo "Nueva sesión"
  cwd=$(pwd)
  read -rp "¿Lanzar desde ${cwd}? [Y/n]: " ok
  if [ "$ok" = "n" ] || [ "$ok" = "N" ]; then
    read -rp "Directorio: " work_dir
    work_dir="${work_dir/#\~/$HOME}"
    while [ -n "$work_dir" ] && [ ! -d "$work_dir" ]; do
      echo "No existe. Intenta de nuevo o Enter para cancelar."
      read -rp "Directorio: " work_dir
      work_dir="${work_dir/#\~/$HOME}"
    done
    if [ -d "$work_dir" ]; then
      cd "$work_dir"
    fi
  fi
  echo "Directorio: $(pwd)"
fi

read -rp "¿Omitir permisos (dangerously-skip-permissions)? [s/N]: " skip_perm
SKIP_FLAG=""
if [ "$skip_perm" = "s" ] || [ "$skip_perm" = "S" ]; then
  SKIP_FLAG="--dangerously-skip-permissions"
  echo "Permisos omitidos"
fi

if $USE_PROXY; then
  kill_port_4000
  echo ""
  echo "Starting liteLLM proxy..."
  litellm --config "$CONFIG" --port 4000 > "$LITELLM_LOG" 2>&1 &
  echo $! > "$PIDFILE"

  for i in $(seq 1 30); do
    if curl -s "http://0.0.0.0:4000/health/readiness" > /dev/null 2>&1; then
      echo "liteLLM proxy ready on port 4000"
      break
    fi
    if [ "$i" -eq 30 ]; then
      echo "ERROR: liteLLM proxy failed to start"
      cat "$LITELLM_LOG"
      exit 1
    fi
    sleep 1
  done

  export ANTHROPIC_BASE_URL="http://0.0.0.0:4000"
  export ANTHROPIC_AUTH_TOKEN="$LITELLM_KEY"
elif [ "$MODEL" = "opencode-go" ]; then
  export ANTHROPIC_BASE_URL="https://opencode.ai/zen/go/v1"
  export ANTHROPIC_AUTH_TOKEN="$OPENCODE_GO_API_KEY"
  echo "Usando OpenCode Go ($MODEL)"
else
  echo ""
  echo "Usando Anthropic directo (sin proxy)"
fi

echo ""
echo "Starting Claude Code..."
echo "  Model:      ${MODEL}"
echo "  Via proxy:  ${USE_PROXY}"
echo "  Resume:     ${RESUME_FLAG:-ninguna}"
echo "  Skip perms: ${SKIP_FLAG:-no}"
echo ""

CLAUDE_EXIT=0
if [ "$MODEL" = "anthropic-direct" ]; then
  claude $RESUME_FLAG $SKIP_FLAG "$@" || CLAUDE_EXIT=$?
else
  claude --model "$MODEL" $RESUME_FLAG $SKIP_FLAG "$@" || CLAUDE_EXIT=$?
fi

echo ""
echo "============================================"
echo "Claude Code finalizó con código: $CLAUDE_EXIT"
echo "============================================"
echo ""
echo "Presiona Enter para cerrar esta ventana..."
read -r
