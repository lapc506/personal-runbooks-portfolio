  <data name="A_Copilot.Label" xml:space="preserve"><value>Disable Copilot</value></data>
  <data name="A_Copilot.Desc" xml:space="preserve"><value>Removes the built-in AI assistant and its button from search/Start.</value></data>
  <data name="A_Copilot.Tip" xml:space="preserve"><value>TurnOffWindowsCopilot=1 + ShowCopilotButton=0.</value></data>
  <data name="A_Copilot.Impl" xml:space="preserve"><value>The Copilot panel and button disappear; local search stays available, but the system's AI assistant stops acting.</value></data>
  <data name="A_Copilot.Risk" xml:space="preserve"><value>Reversible. You lose the AI helper, but Windows remains stable.</value></data>
  <data name="A_Recall.Label" xml:space="preserve"><value>Disable Recall</value></data>
  <data name="A_Recall.Desc" xml:space="preserve"><value>Disables Windows Recall and its contextual AI history features.</value></data>
  <data name="A_Recall.Tip" xml:space="preserve"><value>DisableRecall / WindowsAI policy.</value></data>
  <data name="A_Recall.Impl" xml:space="preserve"><value>Turns off recent-activity and contextual AI memory. Useful if you do not want Windows to keep that history.</value></data>
  <data name="A_Recall.Risk" xml:space="preserve"><value>Functional: you lose Recall context; it is reversible but changes the productivity experience.</value></data>
  <data name="A_ClickToDo.Label" xml:space="preserve"><value>Disable Click to Do</value></data>
  <data name="A_ClickToDo.Desc" xml:space="preserve"><value>Turns off AI text/image analysis features in Click to Do.</value></data>
  <data name="A_ClickToDo.Tip" xml:space="preserve"><value>DisableClickToDo.</value></data>
  <data name="A_ClickToDo.Impl" xml:space="preserve"><value>Disables system AI text and image analysis for the feature; useful if you don't use it.</value></data>
  <data name="A_ClickToDo.Risk" xml:space="preserve"><value>Low risk: it removes AI features, not Windows stability. Reversible.</value></data>
  <data name="T_Ads.Label" xml:space="preserve"><value>Remove personalized Windows ads</value></data>
  <data name="T_Ads.Desc" xml:space="preserve"><value>Removes the advertising ID and Windows tailored experiences.</value></data>
  <data name="T_Ads.Tip" xml:space="preserve"><value>AdvertisingInfo\Enabled=0 + TailoredExperiences=0.</value></data>
  <data name="T_Explorer.Label" xml:space="preserve"><value>Show extensions and hidden files, open in This PC</value></data>
  <data name="T_Explorer.Desc" xml:space="preserve"><value>Shows extensions and hidden files; opens in This PC.</value></data>
  <data name="T_Explorer.Tip" xml:space="preserve"><value>HideFileExt=0, Hidden=1, LaunchTo=1.</value></data>
  <data name="T_Taskbar.Label" xml:space="preserve"><value>Use the classic left bar without Widgets</value></data>
  <data name="T_Taskbar.Desc" xml:space="preserve"><value>Classic alignment without distractions.</value></data>
  <data name="T_Taskbar.Tip" xml:space="preserve"><value>TaskbarAl=0, TaskbarDa=0, ShowTaskViewButton=0.</value></data>
  <data name="T_Search.Label" xml:space="preserve"><value>Search locally only, without Bing or Copilot</value></data>
  <data name="T_Search.Desc" xml:space="preserve"><value>Local search only, no assistant.</value></data>
  <data name="T_Search.Tip" xml:space="preserve"><value>DisableSearchBoxSuggestions=1, TurnOffWindowsCopilot=1, ShowCopilotButton=0.</value></data>
  <data name="S_Telemetry.Label" xml:space="preserve"><value>Turn off telemetry and HP/NVIDIA background programs</value></data>
  <data name="S_Telemetry.Desc" xml:space="preserve"><value>DiagTrack, dmwappushservice, RetailDemo, InventorySvc, nvagent, HP.</value></data>
  <data name="S_Telemetry.Tip" xml:space="preserve"><value>No dependents on Home.</value></data>
  <data name="S_Xbox.Label" xml:space="preserve"><value>Turn off Xbox and Game Bar (only if you don't game)</value></data>
  <data name="S_Xbox.Desc" xml:space="preserve"><value>Only if you don't game.</value></data>
  <data name="S_Xbox.Tip" xml:space="preserve"><value>XblAuthManager, XblGameSave, XboxGipSvc, XboxNetApiSvc.</value></data>
  <data name="S_Maps.Label" xml:space="preserve"><value>Turn off Maps and location</value></data>
  <data name="S_Maps.Desc" xml:space="preserve"><value>Only if you don't use them.</value></data>
  <data name="S_Maps.Tip" xml:space="preserve"><value>MapsBroker + lfsvc.</value></data>
  <data name="S_SysMain.Label" xml:space="preserve"><value>Turn off app preloading into memory (SysMain)</value></data>
  <data name="S_SysMain.Desc" xml:space="preserve"><value>Saves RAM (measure before/after).</value></data>
  <data name="S_SysMain.Tip" xml:space="preserve"><value>Slows down opens on HDD.</value></data>
  <data name="S_Misc.Label" xml:space="preserve"><value>Turn off background helpers (compatibility, links, network, data)</value></data>
  <data name="S_Misc.Desc" xml:space="preserve"><value>Low risk.</value></data>
  <data name="S_Misc.Tip" xml:space="preserve"><value>Compatibility and minor networking.</value></data>
  <data name="Toast.OkTitle" xml:space="preserve"><value>Safe Debloat</value></data>
  <data name="Toast.OkMsg" xml:space="preserve"><value>Changes exported ({0} services).</value></data>
  <data name="Toast.NothingTitle" xml:space="preserve"><value>Safe Debloat</value></data>
  <data name="Toast.NothingMsg" xml:space="preserve"><value>No changes: nothing selected.</value></data>
